{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cf-cal-replication",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],

  "observability": {
    "enabled": true
  },

  // D1 Database — run `npx wrangler d1 create cal-replication-db` and replace database_id below.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cal-replication-db",
      "database_id": "<YOUR_D1_DATABASE_ID>",
      "migrations_dir": "./migrations"
    }
  ],

  // KV Namespace — run `npx wrangler kv namespace create TOKEN_STORE` and replace id below.
  "kv_namespaces": [
    {
      "binding": "TOKEN_STORE",
      "id": "<YOUR_KV_NAMESPACE_ID>"
    }
  ],

  // Durable Object whose self-rearming alarm runs the sync engine every 10
  // minutes (plan.md §5, incremental delta sync) — replaces the old Cron
  // Trigger, see task_plan.md Phase 10 and src/services/syncScheduler.ts.
  "durable_objects": {
    "bindings": [{ "name": "SYNC_SCHEDULER", "class_name": "SyncScheduler" }]
  },
  // SQLite-backed classes are required on the Workers Free plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SyncScheduler"] }],

  // Written out explicitly: omitting `triggers` leaves a previously deployed
  // cron in place, and a lingering cron would run the sync alongside the alarm.
  "triggers": {
    "crons": []
  }
}
