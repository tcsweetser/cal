# Copy this file to .dev.vars for local development (`wrangler dev` reads .dev.vars automatically).
# In production, set these with `wrangler secret put <NAME>` — never commit real values.

# Google Cloud Console OAuth 2.0 credentials (Web application type).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Random secret used to sign/encrypt session cookies. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=

# Separate random secret used only to encrypt OAuth tokens at rest in Cloudflare KV.
# Must NOT be the same value as SESSION_SECRET (see plan.md §5.2). Generate with:
#   openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Email address of the Google account allowed to log into the dashboard (the `primary` account).
PRIMARY_ACCOUNT_EMAIL=

# Resend API key, used to send trusted-party invite/verification emails (see
# src/lib/emailService.ts, task_plan.md Phase 7). Needs a verified sending
# domain in the Resend dashboard.
RESEND_API_TOKEN=

# The "From" address for outbound invite/verification emails — must be on a
# domain verified in Resend.
CAL_FROM_ADDRESS=
