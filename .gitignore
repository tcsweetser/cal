# Reference-only scratch files, not part of the implementation
gemini-code-*

# Claude Code local session metadata, not part of the project deliverable
.claude/

# Node / build
node_modules/
dist/

# Wrangler local state and build cache
.wrangler/

# Local dev secrets — never commit real values (see .env.example)
.dev.vars
.dev.vars.*
.env
.env.*
!.env.example

# Your own deployment's real KV/D1 IDs (and optionally account_id) — never
# commit real resource IDs into wrangler.jsonc, which stays a placeholder
# template for anyone else deploying this project. Copy wrangler.jsonc to
# wrangler.local.jsonc, fill in your real IDs, then pass `-c wrangler.local.jsonc`
# to any wrangler command (or use the `*:local` npm scripts).
wrangler.local.jsonc

# Generated by `wrangler types` — regenerate locally, don't track
worker-configuration.d.ts

# OS / editor
.DS_Store
